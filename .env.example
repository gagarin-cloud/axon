# Postgres with the pgvector extension (docker compose up -d db)
DATABASE_URL=postgres://axon:axon@localhost:54329/axon

# Default project for MCP clients configured per repository; makes `project` optional on every tool.
# AXON_PROJECT=acme/api

# Local embedding model (ONNX, via transformers.js). One model per database; switch with `axon reembed`.
AXON_EMBED_MODEL=onnx-community/Qwen3-Embedding-0.6B-ONNX
AXON_EMBED_DTYPE=q8
AXON_MODEL_DIR=.models

# Similarity thresholds, calibrated for Qwen3-Embedding-0.6B (recalibrate with `axon eval` if you change models).
AXON_DEDUP_SIMILARITY=0.85
AXON_LINK_SUGGEST_SIMILARITY=0.55
AXON_SEARCH_MIN_SIMILARITY=0.35

# Max links per memory.
AXON_MAX_LINKS=32

# Max active memories per project; `remember` answers 422 beyond it (archived and superseded ones don't count).
# Unset means unlimited.
# AXON_MAX_MEMORIES=5000

# HTTP server (REST /v1 + MCP /mcp). No auth: keep it on localhost or behind an authenticating proxy.
AXON_HTTP_HOST=127.0.0.1
AXON_HTTP_PORT=7717

# Encrypts memory title, body and source at rest (AES-256-GCM) when set. Generate with `openssl rand -base64 32`.
# Keep it safe: without it encrypted memories can't be read. Convert existing rows with `axon encrypt` / `axon decrypt`.
# AXON_ENCRYPTION_KEY=

# The key to rotate to. Read only by `axon rotate-key`; unset it again once the rotation is done.
# AXON_ENCRYPTION_KEY_NEW=
